# ═══════════════════════════════════════════════════════
#  灵感工作台 · 部署环境变量模板
#  复制为 .env 后填入真实值
# ═══════════════════════════════════════════════════════

# 通义千问 API Key（必填）
# 在 https://dashscope.console.aliyun.com/apiKey 申请
QWEN_API_KEY=sk-ws-your-key-here

# ─── 数据后端 ───
DATA_BACKEND=sqlite
DB_PATH=/data/inspiration/inspiration.db

# ─── 图片存储后端 ───
# 'local' = 本地磁盘（够用 1-2 万张图）
# 'oss' = 阿里云 OSS（更可靠，0.3 元/GB/月）
IMAGE_BACKEND=local
IMAGE_DIR=/data/inspiration/images

# ─── 阿里云 OSS（仅当 IMAGE_BACKEND=oss 时需要）──
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# ─── 服务器 ───
PORT=3000
NODE_ENV=production
LOG_REQUESTS=0

# ─── API 鉴权 Token（防止别人访问你的 API）──
# 部署时 deploy.sh 会自动生成，也可以自己设
# API_TOKEN=your-secret-token-here
